{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparkmux",
  "version": "0.1.5",
  "identifier": "com.sparkmux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sparkmux",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Desktop app that owns a private tmux server",
    "longDescription": "Sparkmux launches a dedicated tmux server (-L sparkmux) and shows tiled real terminals, one xterm.js view per pane. Your default tmux server is never touched. Quit detaches; the server stays up.",
    "copyright": "Copyright © 2026 Darren Koh",
    "licenseFile": "../../../LICENSE",
    "publisher": "Darren Koh",
    "homepage": "https://github.com/darrenkoh/sparkmux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
